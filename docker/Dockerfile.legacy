FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
ENV DEBIAN_FRONTEND=noninteractive HF_HOME=/cache/huggingface TORCH_HOME=/cache/torch CUDA_CACHE_PATH=/cache/cuda
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 7860
CMD ["python", "minimal_inference/gradio_app.py", "--single_gpu", "--ckpt_dir", "/models/Wan2.2-S2V-14B", "--save_dir", "/data/legacy", "--server_port", "7860"]
