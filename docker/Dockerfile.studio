FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/cache/huggingface TORCH_HOME=/cache/torch CUDA_CACHE_PATH=/cache/cuda
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-studio.txt ./
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-studio.txt
COPY . .
RUN mkdir -p /data /models /cache
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "studio.main:app", "--host", "0.0.0.0", "--port", "8000"]
